# Generate a URL-safe random password; do not use : / @ in this connection-string value.
POSTGRES_PASSWORD=
PUBLIC_ORIGIN=https://localhost
SECURE_COOKIES=true
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
MAX_TARGETS=256
MAX_PORTS=10000
MAX_QUEUE=32
MAX_CONCURRENT_RUNS=2
# Enable only after reviewing docs/security.md and worker egress policy.
EYEWITNESS_ENABLED=false
